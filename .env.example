# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE - BACKEND
# Copy this file to .env or paste into Railway / Render Environment Variables
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# Authentication
JWT_SECRET=your-secure-production-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_RAILWAY_HOST:PORT/railway
ENABLE_POSTGRES=true

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Venixa <support@yourdomain.com>

# AI & LLM Configuration for Seasonal Insights
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
